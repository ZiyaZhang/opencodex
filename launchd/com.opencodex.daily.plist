<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenCodex's daily run (see "无人值守" in the README). launchd expands neither ~ nor variables, so the README's install replaces the two
  placeholders below, the script's path and the log file's, with absolute paths. The script's own log is in the data directory's logs/;
  the log file below only gets what bash prints outside it. Settings of the script (DSH_BIN, DSH_PROFILE, DSH_HOME, OPENCODEX_TIMEOUT_MIN)
  go in EnvironmentVariables.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opencodex.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT_PATH__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__</string>
</dict>
</plist>
