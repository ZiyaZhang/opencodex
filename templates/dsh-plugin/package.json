{
  "name": "__PLUGIN_NAME__",
  "version": "0.1.0",
  "description": "An original DSH plugin generated with OpenCodex",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "main": "./dist/host/index.js",
  "types": "./dist/types/host/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/host/index.d.ts", "default": "./dist/host/index.js" },
    "./client": { "types": "./dist/types/client/index.d.ts", "default": "./dist/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build",
    "package": "npm run build && npm pack --ignore-scripts --pack-destination release",
    "prepack": "npm run build"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5-alpha.1" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}
